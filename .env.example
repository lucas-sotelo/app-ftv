# ------------------------------------------------------------------
# Supabase — obtidos em Project Settings > API
# ------------------------------------------------------------------

# URL do projeto Supabase (ex.: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (publishable / anon). É a ÚNICA chave que pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave service_role. SOMENTE para scripts server-only (ex.: importação legada)
# e testes de integração. NUNCA importar em módulo client-side, nunca versionar.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública da aplicação, usada em links de convite e redirect de auth.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Somente para o script de importação legada (scripts/import-legacy-data.ts)
# ------------------------------------------------------------------

# UUID do grupo de destino da importação. Também pode ser passado por argumento.
GROUP_ID=

# ------------------------------------------------------------------
# Somente para os testes E2E (Playwright)
# ------------------------------------------------------------------
E2E_BASE_URL=http://localhost:3000
